{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phrases",
  "type": "object",
  "required": [],
  "properties": {
    "swaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "weak", "strong"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "src": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]+$"}},
          "lang": {"enum": ["en", "ru", "any"]},
          "weak": {"type": "string"},
          "strong": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "src": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]+$"}},
          "lang": {"enum": ["en", "ru", "any"]},
          "text": {"type": "string"},
          "use_when": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "anchor_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "src": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]+$"}},
          "lang": {"enum": ["en", "ru", "any"]},
          "text": {"type": "string"},
          "fits": {
            "type": "array",
            "items": {
              "enum": [
                "opening",
                "motivation",
                "behavioural",
                "failure",
                "weakness",
                "strength",
                "situational",
                "planning",
                "hard_skills",
                "self_assessment",
                "closing",
                "negotiation",
                "presentation",
                "all"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "joining": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "src": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]+$"}},
          "lang": {"enum": ["en", "ru", "any"]},
          "text": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "banned_in_specific_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "src": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]+$"}},
          "lang": {"enum": ["en", "ru", "any"]},
          "text": {"type": "string"},
          "fix": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
