# Copy to .env and fill in values
APP_API_KEY=your-secret-key-here
OPENAI_API_KEY=
TAVILY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: directory for the SQLite databases (docker-compose sets /app/data)
DATA_DIR=
# Optional: Redis queue. Leave empty to run jobs in background threads.
# docker-compose sets redis://redis:6379/0 and starts an `rq worker` service.
REDIS_URL=
# Set to true to charge credits for sessions and answer generation
CREDITS_ENFORCED=false
FRONTEND_ORIGIN=
